# ホスト上で `bun run dev` するためのテンプレート。
#   cp .env.example .env.local
# 秘密情報は空欄のまま配布する。実値は .env.local にのみ記入し、コミットしないこと。
# Docker で起動する場合は .env.docker.example を使う（docs/development/docker-dev.md）。

# --- Database (Prisma + Accelerate) ---
# Prisma Accelerate 接続 URL
DATABASE_URL=
# マイグレーション用の直接 PostgreSQL URL
DIRECT_URL=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Webhook 署名 (Svix)
WEBHOOK_SECRET=
# 任意 (未設定なら Clerk の既定値)。src/ は参照せず Clerk がライブラリ設定として読む。
# 下記 3 つは Clerk の既定値と同一だが、既定値の変更に依存しないよう明示的にピンする。
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# Stripe Webhook 署名検証
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# 非秘密の既定値（sandbox）。本番は https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --- Cloudinary (画像) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=
# アップロードウィジェットの upload preset。未設定なら既存の fefik77l。検証時だけテスト用 preset を指定する
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Rate limit (ADR-009) ---
# cookie 書き込み API の 1 分あたり上限（IP ごと・インスタンスごと）。未設定なら 5
RATE_LIMIT_COOKIE_PER_MIN=

# --- Notifications (plan 086 / ADR-010) ---
# メールプロバイダ。未設定・stub なら実送信しない（ローカル・CI の既定）。未知の値は送信時に throw
EMAIL_PROVIDER=
# /api/cron/notifications（sweeper）の Bearer トークン。未設定なら 503 を返して何もしない
CRON_SECRET=

# --- その他 ---
# 地域判定 (userCountry)
IPINFO_TOKEN=
# 例: http://localhost:3000
NEXT_PUBLIC_APP_URL=
